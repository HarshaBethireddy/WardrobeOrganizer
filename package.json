{
  "name": "wardrobe-stylist",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Personal wardrobe stylist: catalog clothes from photos, get occasion-aware outfits, log what you wore.",
  "scripts": {
    "predev": "node scripts/copy-ort.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ort.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "labels": "node scripts/build-label-embeddings.mjs",
    "verify:dist": "node scripts/check-dist.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "comlink": "^4.4.2",
    "culori": "^4.0.2",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "dexie-export-import": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^5.5.7",
    "react-router": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "workbox-window": "^7.4.1"
  }
}
